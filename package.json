{
  "name": "fieldnotes-ui",
  "version": "0.1.0",
  "description": "Composable React UI with the Fieldnotes design language and scoped runtime themes.",
  "type": "module",
  "license": "MIT",
  "private": true,
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./primitives": {
      "types": "./dist/primitives/index.d.ts",
      "import": "./dist/primitives.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core.js"
    },
    "./composites": {
      "types": "./dist/composites/index.d.ts",
      "import": "./dist/composites.js"
    },
    "./patterns": {
      "types": "./dist/patterns/index.d.ts",
      "import": "./dist/patterns.js"
    },
    "./themes": {
      "types": "./dist/themes/index.d.ts",
      "import": "./dist/themes.js"
    },
    "./hooks": {
      "types": "./dist/hooks/index.d.ts",
      "import": "./dist/hooks.js"
    },
    "./styles.css": "./dist/styles.css",
    "./tailwind.css": "./dist/tailwind.css",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bojan-Ivanovski/fieldnotes-ui.git"
  },
  "homepage": "https://github.com/Bojan-Ivanovski/fieldnotes-ui#readme",
  "bugs": {
    "url": "https://github.com/Bojan-Ivanovski/fieldnotes-ui/issues"
  },
  "keywords": [
    "react",
    "ui",
    "design-system",
    "tailwind",
    "fieldnotes"
  ],
  "engines": {
    "node": ">=24"
  },
  "peerDependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "scripts": {
    "build": "node scripts/generate-tokens.mjs && vite build && tsc -p tsconfig.build.json && node scripts/copy-css.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version:prepare": "changeset version && node scripts/generate-version.mjs && prettier --write CHANGELOG.md package.json src/version.ts",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "check:architecture": "node scripts/check-architecture.mjs",
    "verify:package": "node scripts/verify-package.mjs",
    "test:consumers": "node scripts/prepare-consumers.mjs && node scripts/verify-consumers.mjs",
    "test:browser": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "check:licenses": "node scripts/check-licenses.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run check:architecture && npm test && npm run build && npm run verify:package && npm run check:licenses"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/react-vite": "10.6.2",
    "@tailwindcss/vite": "4.3.3",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "axe-core": "4.14.0",
    "eslint": "10.12.0",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "storybook": "10.6.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "@headless-tree/core": "1.8.0",
    "@headless-tree/react": "1.8.0",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@radix-ui/react-tabs": "1.2.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.57.0",
    "tailwind-merge": "3.7.0"
  }
}
