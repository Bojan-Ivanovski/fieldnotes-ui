{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "declarationDir": "dist",
    "rootDir": "src",
    "types": ["react", "react-dom"]
  },
  "include": ["src"],
  "exclude": [
    "src/components/patterns/prototypes/**",
    "src/components/patterns/settings-example.tsx",
    "src/**/*.test.*",
    "src/**/*.stories.*",
    "src/test-setup.ts",
    "src/styles-entry.ts"
  ]
}
